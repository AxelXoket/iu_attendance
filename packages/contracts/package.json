{
  "name": "@iu-attendance/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./shared": {
      "source": "./src/shared/index.ts",
      "types": "./dist/shared/index.d.ts",
      "default": "./dist/shared/index.js"
    },
    "./*": {
      "source": "./src/*.ts",
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "TZ=UTC vitest run"
  },
  "dependencies": {
    "@iu-attendance/core": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "fast-check": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
