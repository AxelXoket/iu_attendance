# Local-only project documents and the Serena workspace, at the repository root only: a
# source folder of the same name deeper down stays tracked.
/docs/
/.serena/

# Dependencies and build output
node_modules/
/packages/*/dist/
/apps/*/dist/
*.tsbuildinfo
*.tgz

# Test coverage and Stryker output. Only the mutation report folder is ignored,
# so a source folder named reports (the reports module) is still tracked.
/coverage/
/packages/*/coverage/
/apps/*/coverage/
**/reports/mutation/
.stryker-tmp/

# Logs, Node diagnostic reports and memory profiles: they can carry environment values
# and personal data.
*.log
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json
*.heapsnapshot
*.cpuprofile

# Environment and secrets: only .env.example is tracked
.env
.env.*
*.env
!.env.example
.secrets/

# Private keys and key stores. Public certificates (.pem, such as the monitoring test
# roots) are tracked.
*.key
*.p12
*.pfx

# Database dumps hold personal data, wherever they are made.
*.dump

# Virtual phone private keys that the load test seed writes on the load generator
apps/server/test/load/.keys/

# Local editor, operating system and Claude Code files
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
.claude/settings.local.json
