# Local-only project documents
docs/

# Serena workspace files
.serena/

# Dependencies and build output
node_modules/
dist/
*.tsbuildinfo

# Test coverage and Stryker output. Only the mutation report folder is ignored,
# so a source folder named reports (the reports module) is still tracked.
coverage/
**/reports/mutation/
.stryker-tmp/

# Environment and secrets: only .env.example is tracked
.env
.env.*
!.env.example
.secrets/

# Virtual phone private keys that the load test seed writes on the load generator
apps/server/test/load/.keys/
