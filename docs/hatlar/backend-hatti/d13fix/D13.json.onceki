    "packages/contracts/src/ortak/kimlik.ts",
    "packages/contracts/src/ortak/sayfa.ts",
    "packages/contracts/src/ortak/oge-sonucu.ts",
    "packages/contracts/src/ortak/imzali-metin.ts",
    "packages/contracts/src/ortak/basliklar.ts",
    "packages/contracts/src/ortak/surum.ts",
    "packages/contracts/src/ortak/testler/istemci.test.ts",
    "packages/contracts/src/ortak/testler/rota-tablosu.test.ts",
    "packages/contracts/src/ortak/testler/hata-katalogu.test.ts",
    "packages/contracts/src/ortak/testler/surum.test.ts",
    "packages/contracts/src/ortak/testler/semalar.test.ts",
    "packages/contracts/openapi/destek.json",
    "packages/contracts/openapi/kirilma-istisnalari.txt",
    ".github/workflows/sozlesme.yml"
  ],
  "tests": [
    {
      "name": "Bozuk JSON gövdesi tek zarfla 400 alır",
      "kind": "behavior",
      "asserts": "Ayrışmayan ve boş JSON gövdesi 400 API_JSON_BOZUK alır; gövde hataZarfiSemasi'na uyar, istekKimligi X-Istek-Kimligi başlığıyla aynıdır, alanlar boş dizi, beklemeSaniye ve ayrinti null; Content-Type application/json."
    },
    {
      "name": "Şemaya uymayan istekte yalnız alan yolu ve kod döner, değer yankılanmaz",
      "kind": "behavior",
      "asserts": "Deneme rotasına 11 rakamlı ogrenciNo gönderilir: 400 API_ISTEK_GECERSIZ, alanlar[0] = {konum: govde, yol: ogrenciNo, kod: Zod kodu}; cevap gövdesinde ve yakalanan log satırlarında gönderilen rakam dizisi geçmez. Pozitif denetim: 10 rakamlı geçerli numara 200 alır."
    },
    {
      "name": "Beklenmeyen hata yalnız sabit mesaj ve istek kimliği döner",
      "kind": "behavior",
      "asserts": "Deneme rotası 'gizli-ayrinti-123' metinli Error fırlatır: 500 API_SUNUCU_HATASI, mesaj katalogdaki sabit cümle; gövdede 'gizli-ayrinti-123' geçmez; üretim ayarındaki log satırında hata sınıfı, dosya ve satır ile rota kalıbı var, mesaj yok."
    },
    {
      "name": "Veritabanı kısıt hatası yalnız kod ve kısıt adıyla loglanır",
      "kind": "behavior",
      "asserts": "Deneme rotası istemci_surum_esikleri'ne ON CONFLICT'siz aynı satırı iki kez ekler: cevap 500 zarfı; log satırında 23505 ve istemci_surum_esikleri_platform_kanal_dosya_sirasi_karar_uq var, ihlal eden değerler (detail) yok."
    },
    {
      "name": "Bilinmeyen /v1 yolu zarflı 404 döner",
      "kind": "behavior",
      "asserts": "GET /v1/yok-boyle-bir-yol: 404 API_UC_BULUNAMADI, Content-Type application/json (panel sayfası değil), Cache-Control: no-store."
    },
    {
      "name": "Her cevap no-store ve sunucu istek kimliği taşır",
      "kind": "behavior",
      "asserts": "200, 400, 401, 403, 404, 413, 415, 429, 500 ve 503 cevaplarının hepsinde Cache-Control: no-store ve UUID biçimli X-Istek-Kimligi var; iki istek farklı kimlik alır; istemcinin gönderdiği X-Request-Id ve X-Istek-Kimligi değerleri kullanılmaz."
    },
    {
      "name": "Oturum isteyen her rota kimliksiz istekte 401 alır",
      "kind": "behavior",
      "asserts": "TUM_ROTALAR'daki kimliği yalnız oturum olan her rota ve deneme rotaları kimliksiz istekte gövde okunmadan 401 API_KIMLIK_GEREKLI alır; girişsiz rotalar 401 almaz (pozitif denetim); taranan rota sayısı sıfır değildir (zemin denetimi deneme rotalarıyla)."
    },
    {
      "name": "Yanlış rol 403 alır, doğru rol geçer",
      "kind": "behavior",
      "asserts": "Yalnız yonetici rollü deneme rotası hoca oturumuyla 403 API_ROL_YETKISIZ, yönetici oturumuyla 200; personel beyanlı rota hoca ve yöneticiye açık, öğrenciye 403; /yonetim/ yolunda yonetici dışı rol beyan eden deneme tanımı açılışı durdurur."
    },
    {
      "name": "Panel dışı Origin'le yazma isteği 403 alır",
      "kind": "behavior",
      "asserts": "Origin https://baska.ornek ile POST, PUT, PATCH ve DELETE 403 API_KOKEN_GECERSIZ alır ve işleyici çalışmaz (yan etki sayacı sıfır); aynı istekler panel Origin'iyle 200; GET isteğinde Origin'e bakılmaz; girişsiz deneme yazma rotası da yabancı Origin'le 403 alır (giriş CSRF'si)."
    },
    {
      "name": "Origin'siz yazma isteğinde çerez okunmaz",
      "kind": "behavior",
      "asserts": "Geçerli panel çereziyle Origin'siz POST oturum kurmaz ve 401 API_KIMLIK_GEREKLI alır; aynı istek panel Origin'iyle 200; Origin'siz GET aynı çerezle 200."
    },
    {
      "name": "Bearer varken çerez okunmaz",
      "kind": "behavior",
      "asserts": "Hocanın Bearer anahtarı ve başka kişinin panel çereziyle gelen istek Bearer sahibinin kimliğiyle işlenir; kapanmış Bearer ve geçerli çerez 401 alır, çereze düşülmez."
    },
    {
      "name": "Cihaz imzalı rotada geçersiz oturum isteği düşürmez",
      "kind": "behavior",
      "asserts": "Deneme cihaz imzalı rotası (kimlik cihazImzasi ve oturum) kapanmış Bearer ve deneme kancasının geçerli saydığı imzayla 200 döner, istek.kimlik.tur cihaz, istek.oturumHatasi D01 kodu; imza da yoksa 401 API_KIMLIK_GEREKLI."
    },
    {
      "name": "JSON dışı içerik ve sıkıştırılmış gövde 415 alır",
      "kind": "behavior",
      "asserts": "text/plain, application/x-www-form-urlencoded ve multipart/form-data gövdeler ile Content-Encoding: gzip taşıyan JSON 415 API_ICERIK_TURU alır; application/json; charset=utf-8 geçer; __proto__ anahtarlı gövde 400 alır."
    },
    {
      "name": "Gövde sınırı tam değerde geçer, bir bayt üstünde 413 alır",
      "kind": "behavior",
      "asserts": "64 KiB sınırlı deneme rotasında tam 65536 baytlık gövde 200, 65537 baytlık 413 API_GOVDE_COK_BUYUK; 1 MiB beyanlı deneme rotası 1 MiB gövdeyi kabul eder; 2 MiB'tan büyük beyan açılışı durdurur."
    },
    {
      "name": "Girişsiz uçta IP sınırı aşılınca 429 ve Retry-After döner, başka IP etkilenmez",
      "kind": "behavior",
      "asserts": "Test seçeneğiyle küçültülmüş girissiz sınırında sınırın bir fazlası 429 API_HIZ_SINIRI; Retry-After pozitif tam sayı ve zarftaki beklemeSaniye ile aynı; başka istemci adresinden gelen istek 200; sahte saat pencereyi geçince ilk adres yeniden 200 alır."
    },
    {
      "name": "Oturum sınıfında sayaç oturuma bağlıdır",
      "kind": "behavior",
      "asserts": "Aynı IP'den iki oturum: birinin sınırı dolunca öbürü 200 almaya devam eder; agir sınıfındaki rota oturum sınıfının sayacını tüketmez."
    },
    {
      "name": "Geçersiz anahtarla gelen istekler IP sayacından düşer",
      "kind": "behavior",
      "asserts": "Aynı IP'den geçersiz Bearer'la gelen istekler girissiz sınırını aşınca 429 alır; aynı IP'den geçerli oturumla gelen istekler bu sayaca girmez ve 200 almaya devam eder."
    },
    {
      "name": "Aşırı yükte 503 ve 15 ile 45 saniye arası Retry-After döner",
      "kind": "behavior",
      "asserts": "Deneme seçeneğiyle baskı açılınca sıradan rota ve bilinmeyen yol 503 API_SUNUCU_YOGUN alır, Retry-After 15 ile 45 arasında; baskiDisi beyanlı deneme rotası (test kipinde izinli) ve kayıtlıysa /health/live ile /v1/durum cevap vermeye devam eder; 100 denemede en az 10 farklı Retry-After değeri görülür."
    },
    {
      "name": "Aşırı yükte oturum kancası hiç çalışmaz",
      "kind": "behavior",
      "asserts": "Baskı açıkken oturum zorunlu deneme rotasına geçerli Bearer'la gelen istek 503 alır ve sahte oturumDogrula işlevinin çağrı sayacı sıfır kalır; baskı kapanınca aynı istek 200 alır ve sayaç bir artar (pozitif denetim)."
    },
    {
      "name": "Geçici veritabanı hataları 503'e çevrilir",
      "kind": "behavior",
      "asserts": "Deneme rotasının fırlattığı UygulamaHatasi('API_SUNUCU_YOGUN') ve SQLSTATE 40P01, 40001, 53300, 57P03 taşıyan hatalar 503 API_SUNUCU_YOGUN ve Retry-After alır; 57014 503 API_SORGU_ZAMAN_ASIMI; 23505 500 API_SUNUCU_HATASI."
    },
    {
      "name": "Sürüm başlıkları bozuk ya da yokken istek reddedilmez",
      "kind": "behavior",
      "asserts": "X-Uygulama-Surumu abc, X-Platform windows ve hiç başlık taşımayan istekler deneme yazma rotasında 200; enDusukSurumDenetle bilinmiyor döner; istek.istemci alanları null."
    },
    {
      "name": "En düşük sürümün altındaki istemci reddedilmez",
      "kind": "behavior",
      "asserts": "Geçerli en düşük sürüm 1.3.0 iken 1.2.0 başlıklı istek deneme yazma rotasında 200; enDusukSurumDenetle altinda; GET /v1/surum guncellemeGerekli true; 1.3.0 başlıklı istekte uygun."
    },
    {
      "name": "GET /v1/surum platform ve kanala göre cevap verir",
      "kind": "behavior",
      "asserts": "Dört kanal için enSonSurum, enDusukSurum ve magazaBaglantisi dosyayla aynı; testflight'ta gecisBaglantisi dolu, ötekilerde null; android ve appstore çifti 400; X-Uygulama-Surumu eksik 400; cevap X-Saat-Belgesi taşımaz."
    },
    {
      "name": "GitHub kademesi aynı kuruluma her gün aynı kararı verir",
      "kind": "behavior",
      "asserts": "Yüzde 0'da hiçbir kurulum, 100'de bütün kurulumlar guncellemeVar alır; yüzde 30'da aynı kurulum kimliği art arda ve sahte saatle ertesi gün aynı cevabı alır; kurulum kimliği olmayan istek kademe dışında sayılır; kademe takvimindeki sonraki adımın başlangıcı geçince yüzde kendiliğinden artar."
    },
    {
      "name": "Dönem içindeki yükseltme ertelenir, dönem arası gelince uygulanır",
      "kind": "behavior",
      "asserts": "donemArasiMi false iken yüksek en düşük sürümlü dosyayla açılış: tabloda ertelendi satırı, GET /v1/surum eski değeri ve yeni enSonSurum'u döner; işlev true ve sahte saat bir dakika ileri olunca uygulandi satırı eklenir ve yeni değer döner; iki uygulama örneği aynı anda değerlendirse de tek uygulandi satırı olur."
    },
    {
      "name": "Düşürme dönem içinde de hemen uygulanır",
      "kind": "behavior",
      "asserts": "donemArasiMi false iken daha düşük en düşük sürümlü daha büyük sıralı dosyayla açılış uygulandi satırı ekler ve GET /v1/surum yeni değeri hemen döner."
    },
    {
      "name": "Küçük sıralı dosya kayıtlı kararı değiştirmez",
      "kind": "behavior",
      "asserts": "Sıra 7 uygulanmışken sıra 6'lı dosyayla açılan örnek yeni satır eklemez, cevap sıra 7'nin değerleriyle aynıdır; aynı sıra farklı içerikle gelince satır eklenmez ve hata logu yazılır."
    },
    {
      "name": "Bozuk yayın bilgisi dosyasıyla uygulama açılmaz",
      "kind": "behavior",
      "asserts": "Şemaya uymayan, eksik kanallı ya da en düşük sürümü en son sürümden büyük dosyada app.ready() dosya yolunu ve Zod yolunu söyleyen iletiyle reddeder; geçerli örnek dosyada açılır (zemin denetimi)."
    },
    {
      "name": "Saat belgesi başlığı yalnız koşullar tutunca eklenir",
      "kind": "behavior",
      "asserts": "Kimlikli istekte geçerli X-Saat-Istegi varsa 200 ve 4xx cevabı X-Saat-Belgesi taşır ve belge isteğin değerini içerir; 429, 500, 503, eşitleme bozukken, girişsiz rotada, saatBelgesi false rotada ve bozuk X-Saat-Istegi'nde başlık yoktur, istek yine işlenir."
    },
    {
      "name": "Rota tablosu dışı ve eksik kayıt açılışı durdurur",
      "kind": "behavior",
      "asserts": "Deneme eklentisi app.get ile tablo dışı yol eklemeye çalışınca açılış hata verir; kayıtlı bir modülün tablodaki bir rotası kaydedilmezse app.ready() eksik rotayı söyleyerek reddeder; tam kayıtta açılır."
    },
    {
      "name": "Rota yalnız beyan ettiği kodları döndürür",
      "kind": "behavior",
      "asserts": "Test kipinde deneme rotası beyan etmediği bir modül kodunu fırlatınca cevap 500 API_SUNUCU_HATASI olur ve log satırı beyan dışı kodu ve rota kalıbını yazar; beyan ettiği kod aynen döner; API_ kodları her rotada örtük geçerlidir; üretim kipinde beyan dışı kod korunur, yalnız uyarı loglanır."
    },
    {
      "name": "Rota tablosu kuralları",
      "kind": "contract",
      "asserts": "TUM_ROTALAR'da (yöntem, yol) ve (modül, ad) tekil; yol sahibinin /v1/<modül> önekiyle ya da dört kök istisnadan biriyle başlar; yol küçük harf, tireli ve ASCII; /yonetim/ yolları yalnız yonetici rolü ister; baskiDisi yalnız /health/live ve /v1/durum'da; her rotada kimlik, hız sınıfı, en çok 2 MiB gövde sınırı ve hatalar listesi var; hatalar listesindeki her kod TUM_HATALAR'da. Taranan rota sayısı sıfır değil (GET /v1/surum zemin)."
    },
    {
      "name": "Hata kataloğu kuralları",
      "kind": "contract",
      "asserts": "TUM_HATALAR'da her kod tek, BÜYÜK_HARF ASCII ve öneki modül adının büyük harfi; HTTP durumu izinli kümede (400, 401, 403, 404, 409, 413, 415, 422, 429, 500, 503); hoca ve öğrenci metni dolu, en çok 200 karakter, süslü parantez yer tutucusu ve rakam dizisi yok; her API_ kodu en az bir senaryoda gerçekten dönüyor (senaryo kapsama listesi)."
    },
    {
      "name": "Cevap şemalarında enum yok, genişleyen alanlar x-extensible-enum taşıyor",
      "kind": "contract",
      "asserts": "Üretilen OpenAPI belgesi taranır: cevap şemalarında enum anahtarlı alan sayısı sıfır (bilerek kapalı liste boş); hata zarfının kod alanı x-extensible-enum taşır ve listede API_ISTEK_GECERSIZ vardır (pozitif denetim); taranan şema sayısı rota sayısından az değil."
    },
    {
      "name": "İstek şemalarında üst sınırlar var",
      "kind": "contract",
      "asserts": "Belgedeki her istek metninde maxLength, her dizide maxItems, her tam sayıda minimum ve maximum var; hiçbir istek nesnesinde additionalProperties false yok (strip); bilerek sınırsız alan listesi boş."
    },
    {
      "name": "Cevaplarda isteğe bağlı alan yok",
      "kind": "contract",
      "asserts": "Belgedeki her cevap nesnesinin bütün özellikleri required listesinde; değeri olmayabilen alanlar null tiplidir."
    },
    {
      "name": "OpenAPI belgesi kararlı ve eksiksiz",
      "kind": "contract",
      "asserts": "Belge iki kez üretilince bayt bayt aynı; anahtarlar sıralı; openapi 3.1.0; her işlemde güvenlik gereksinimi kimlik beyanıyla uyumlu (girissiz boş, oturum Bearer ya da çerez, cihazImzasi ve projeksiyon x-kimlik), isteğe bağlı sürüm ve saat başlıkları yazılı; TUM_ROTALAR'daki her rota belgede var."
    },
    {
      "name": "oasdiff kapısı kırılmayı yakalar",
      "kind": "contract",
      "asserts": "Örnek taban belgeye karşı gönderme yolunda cevap alanı kaldıran belge ERR ile kırmızı; yalnız uç ve isteğe bağlı istek alanı ekleyen belge yeşil; x-extensible-enum listesine değer ekleyen belge yeşil; bir saklı belge değiştirilince saklama denetimi kırmızı."
    },
    {
      "name": "İstemci yardımcısı protokol tablosuna uyar",
      "kind": "contract",
      "asserts": "Sahte fetch ile: JSON olmayan 200 (kampüs giriş sayfası), ayrışmayan JSON, yönlendirme ve zaman aşımı gecici; 400 ve 413 bol; 401 ve 403 dur; 404, 409, 415 ve 422 bol; 408, 429 ve 503 gecici, Retry-After beklemeSaniye'ye geçer; istemciCevapDenetimi açık rotada şemaya uymayan 200 gecici; arkaPlan seçeneği X-Arka-Plan: 1 ekler; telefon kipinde credentials omit."
    },
    {
      "name": "Sürüm karşılaştırması toplam sıralamadır",
      "kind": "property",
      "asserts": "fast-check, en az 1000 deneme: yansıma, ters simetri ve geçişlilik tutar; bölümler sayısal karşılaştırılır (1.10.0 > 1.9.0); geçersiz biçimde surumAyristir null döner ve karşılaştırmaya girmez."
    },
    {
      "name": "Kurulum kovası kararlı ve düzgün dağılır",
      "kind": "property",
      "asserts": "Aynı kurulum kimliği hep aynı kovayı alır; sabit tohumlu 100.000 rastgele UUIDv7'de her kova yüzde 0,8 ile 1,2 arasında; kova 0 ile 99 dışına çıkmaz."
    },
    {
      "name": "Eşik karar işlevi dönem içinde yükseltmez",
      "kind": "property",
      "asserts": "fast-check durum makinesi, en az 500 dizi: rastgele dosya sırası, istenen sürüm ve dönem arası adımlarında geçerli en düşük sürüm donemArasi false adımda hiç artmaz; true adımda kayıtlı en büyük sıralı dosyanın istenen değerine eşitlenir; daha küçük sıralı dosya hiçbir şey değiştirmez."
    },
    {
      "name": "İstemci başlık ayrıştırıcısı hiçbir girdide fırlatmaz",
      "kind": "property",
      "asserts": "fast-check rastgele başlık değerleri ve dizileri: işlev her zaman döner, geçersiz değerler null olur, geçerli değerler aynen korunur."
    },
    {
      "name": "Ders çıkışı yükünde sınırlar ve aşırı yük doğru davranır",
      "kind": "load",
      "asserts": "D15'in k6 ders çıkışı senaryosunda (binlerce ayrı cihaz kimliği, sınırlar açık, 20.000 telefon 1 dakikada): 429 oranı sıfır; bütün 503'ler Retry-After taşır; hız sınıfı tablolarının bellek payı ve gönderim ucunda cevap serileştirmenin süre payı ölçülüp yazılır; under-pressure eşikleri ve sınıf değerleri bu ölçümden sonra kesinleşir."
    },
    {
      "name": "Köken denetimi bozulunca senaryo kırmızı olur",
      "kind": "mutation",
      "asserts": "koken.ts'teki Origin karşılaştırması her zaman eşit dönecek biçimde bozulur: \"Panel dışı Origin'le yazma isteği 403 alır\" senaryosu kırmızı olur; özgün baytlar geri yazılır ve md5 eşleşir."
    },
    {
      "name": "Çerez Origin'siz okunursa senaryo kırmızı olur",
      "kind": "mutation",
      "asserts": "Kimlik bilgisi çıkarma kuralı Origin'siz yazma isteğinde çerezi okuyacak biçimde bozulur: \"Origin'siz yazma isteğinde çerez okunmaz\" senaryosu kırmızı olur; geri yazılır, md5 eşleşir."
    },
    {
      "name": "genisleyenEnum enum üretirse sözleşme testi kırmızı olur",
      "kind": "mutation",
      "asserts": "genisleyenEnum z.enum dönecek biçimde bozulur: \"Cevap şemalarında enum yok, genişleyen alanlar x-extensible-enum taşıyor\" testi kırmızı olur; geri yazılır, md5 eşleşir."
    },
    {
      "name": "Dönem içi koruma kaldırılınca erteleme senaryosu kırmızı olur",
      "kind": "mutation",
      "asserts": "esik-karari.ts'te donemArasi koşulu true kabul edilecek biçimde bozulur: \"Dönem içindeki yükseltme ertelenir, dönem arası gelince uygulanır\" senaryosu ve \"Eşik karar işlevi dönem içinde yükseltmez\" testi kırmızı olur; geri yazılır, md5 eşleşir."
    },
    {
      "name": "Oturum kancası baskıdan önceye alınırsa senaryo kırmızı olur",
      "kind": "mutation",
      "asserts": "apiKur'da oturum kancası under-pressure'dan önce kaydedilecek biçimde bozulur: \"Aşırı yükte oturum kancası hiç çalışmaz\" senaryosu kırmızı olur (sayaç sıfır kalmaz); geri yazılır, md5 eşleşir."
    },
    {
      "name": "Yakalayıcı gelen değeri yankılarsa senaryo kırmızı olur",
      "kind": "mutation",
      "asserts": "hata-yakalayici.ts Zod issue mesajını zarfa koyacak biçimde bozulur: \"Şemaya uymayan istekte yalnız alan yolu ve kod döner, değer yankılanmaz\" senaryosu kırmızı olur; geri yazılır, md5 eşleşir."
    }
  ],
