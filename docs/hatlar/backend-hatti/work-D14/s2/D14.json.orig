  "tests": [
    {
      "name": "İşlem geri alınınca kuyrukta iş kalmaz",
      "kind": "behavior",
      "asserts": "Aynı işlemde isGonder çağrılıp işlem hatayla geri alınınca kuyrukta o işten 0 iş bulunur; zemin denetimi: aynı adımlar hatasız bitince tam 1 iş bulunur."
    },
    {
      "name": "Tekillik anahtarı ikinci işi açmaz",
      "kind": "behavior",
      "asserts": "exclusive test kuyruğunda aynı anahtarla ikinci isGonder isId null döner ve kuyrukta 1 iş kalır; farklı anahtarla 2 iş olur (artı denetim); standard kuyrukta anahtar IS_KUYRUGU_TEKILLIK_ANAHTARI_GECERSIZ verir."
    },
    {
      "name": "İş verisi kuyruk şemasıyla doğrulanır",
      "kind": "behavior",
      "asserts": "Şemaya uymayan veri IS_KUYRUGU_VERI_GECERSIZ ile çağıranın işlemini geri aldırır, 8 KiB üstü veri IS_KUYRUGU_VERI_BUYUK verir, 14 gün ileri baslamaAni IS_KUYRUGU_BASLAMA_ANI_GECERSIZ verir; geçerli veri kuyruğa girer."
    },
    {
      "name": "Hata veren iş yeniden denenir, denemeler bitince ölü kuyruğa düşer",
      "kind": "behavior",
      "asserts": "Her seferinde hata veren test işi, TestClock ile beklemeler geçilerek 1 + 3 kez çalışır; sonra <ad>_olu kuyruğunda 1 iş belirir ve isSagligi oluMektup 1 gösterir. Bir kez hata verip sonra başaran iş completed olur, ölü kuyruk boş kalır."
    },
    {
      "name": "Süresi aşan iş bakımda yeniden denemeye geçer",
      "kind": "behavior",
      "asserts": "Asılı kalan test işi için saat sureAsimiSaniye ötesine alınıp supervise(ad) çalıştırılınca iş retry olur; süre dolmadan çalıştırılan bakım işe dokunmaz (zemin denetimi)."
    },
    {
      "name": "İş hatası çıktıya ve loga değer sızdırmaz",
      "kind": "behavior",
      "asserts": "Mesajında örnek öğrenci numarası, isim ve e-posta adresi olan hata fırlatan işin pg-boss çıktısında ve yakalanan loglarda bu üç değer yoktur; uygulama hata kodu, SQLSTATE ve kısıt adı vardır. Artı denetim: fırlatılan hatanın mesajında değerler gerçekten vardır."
    },
    {
      "name": "Günlük iş işçi kapalıyken kaçarsa açılınca bir kez çalışır",
      "kind": "behavior",
      "asserts": "Zamanlaması açık işçi durdurulup saat setTime ile 3 gün ileri alınır, işçi açılıp saat 1 dakika ilerletilince eposta_gonderim_temizligi kuyruğunda tam 1 iş oluşur (missed: once, 3 kaçan gün için 3 değil); her dakika çalışan test işinde yalnız açılıştan sonraki dakika için 1 iş oluşur, kaçan dakikalar için oluşmaz (skip)."
    },
    {
      "name": "Zamanlama İstanbul saatiyle tetiklenir",
      "kind": "behavior",
      "asserts": "Saat 2026-10-05T23:40Z'den (İstanbul 02:40) 6 dakika ilerletilince eposta_gonderim_temizligi bir kez tetiklenir; 2026-10-06T02:40Z'den (İstanbul 05:40, UTC 02:40) ilerletilince tetiklenmez (zemin denetimi)."
    },
    {
